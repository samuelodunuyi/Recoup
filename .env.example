# ─── Recoup — example environment ───────────────────────────────────────────
# Copy to `.env` and fill in. Never commit a real .env.
# Demo mode runs on synthetic data; no live Paystack/Flutterwave/WhatsApp needed.

# Provider selection. The LLM client tries PRIMARY first, then falls back to
# FALLBACK on error/timeout. Valid values: anthropic | openai
LLM_PRIMARY=anthropic
LLM_FALLBACK=openai

# Model per provider (override to trade cost/latency for capability).
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o

# Provider credentials. Leave the fallback's key blank to disable fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Request tuning
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# Postgres + pgvector. Host `db` matches the docker-compose service name;
# use `localhost` when running the app outside Docker.
DATABASE_URL=postgresql://recoup:recoup@db:5432/recoup

# App
DEMO_MODE=true

# Security. Admin endpoints (/handoffs, /metrics, /outcome, /playbook, /llm/*)
# require X-API-Key == RECOUP_API_KEY and are disabled while it's empty. The
# failed-payment webhook is disabled until WEBHOOK_SECRET is set.
# Generate values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
RECOUP_API_KEY=
WEBHOOK_SECRET=
# Set true only when running behind a reverse proxy that appends X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Spend caps (USD): per conversation, and across everything per rolling 24h.
MAX_COST_PER_CONVERSATION=0.50
MAX_DAILY_COST_USD=5

# This deployment's public URL (makes demo checkout links absolute), e.g.
# https://recoup.onrender.com
PUBLIC_BASE_URL=

# ─── Payment processors (optional; demo checkout + reminders when empty) ───
# Paystack signs webhooks with this key: it enables /webhooks/paystack, real
# checkout links and saved-card retries. Test keys (sk_test_…) work.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "secret hash" you choose in the Flutterwave dashboard (webhook verification).
FLUTTERWAVE_SECRET_HASH=
PAYMENT_REDIRECT_URL=

# ─── WhatsApp Cloud API (optional; replies only go to the browser demo when empty) ───
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Approved template for the first message; body params {{1}} name, {{2}} amount, {{3}} link.
WHATSAPP_OPENING_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Prefix applied to local-format numbers ("0803…" → "234803…").
DEFAULT_COUNTRY_CODE=234

# ─── Scheduled retries ───
DEFAULT_RETRY_DAYS=3
RETRY_POLL_SECONDS=60

# Human-handoff email (optional; both SMTP_HOST and HANDOFF_EMAIL must be set).
HANDOFF_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=recoup@localhost
