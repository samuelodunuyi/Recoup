# ─── Recoup — example environment ───────────────────────────────────────────
# Copy to `.env` and fill in. Never commit a real .env.
# Demo mode runs on synthetic data; no live Paystack/Flutterwave/WhatsApp needed.

# Provider selection. The LLM client tries PRIMARY first, then falls back to
# FALLBACK on error/timeout. Valid values: anthropic | openai
LLM_PRIMARY=anthropic
LLM_FALLBACK=openai

# Model per provider (override to trade cost/latency for capability).
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o

# Provider credentials. Leave the fallback's key blank to disable fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Request tuning
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# Postgres + pgvector. Host `db` matches the docker-compose service name;
# use `localhost` when running the app outside Docker.
DATABASE_URL=postgresql://recoup:recoup@db:5432/recoup

# App
DEMO_MODE=true
